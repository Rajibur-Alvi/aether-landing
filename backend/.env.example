# ═══════════════════════════════════════════════════════════════════════════════
# Aether Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Groq (LLM) ──────────────────────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Pinecone (Vector DB) ──────────────────────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
# IMPORTANT: Create your index with dimension=768, metric=cosine
#            (matches BAAI/bge-base-en-v1.5 embedding model)
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=entropy-vectors

# ── Supabase (Database + Auth) ────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...   # service_role key (keep secret!)
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── Lemon Squeezy (Payments — free to set up) ─────────────────────────────────
# Setup: https://app.lemonsqueezy.com
#   1. Create a Store
#   2. Create two subscription Products: "Signal" ($29/mo) and "Signal Pro" ($99/mo)
#   3. Copy the Variant ID from each product's Variants tab
#   4. Create an API key under Settings → API
#   5. Add a Webhook (Settings → Webhooks):
#         URL: https://your-render-url.onrender.com/api/webhook/lemonsqueezy
#         Events: order_created, subscription_created, subscription_updated
LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_SIGNAL_VARIANT_ID=111111        # Signal $29/mo variant ID
LEMONSQUEEZY_SIGNAL_PRO_VARIANT_ID=222222    # Signal Pro $99/mo variant ID

# ── App URL (your Vercel frontend) ────────────────────────────────────────────
# Used for payment redirect after successful checkout
APP_URL=https://yourapp.vercel.app

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here — find it in your Vercel project dashboard.
CORS_ORIGINS_RAW=https://yourapp.vercel.app,http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
